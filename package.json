{
  "name": "logic-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/practice",
    "packages/logic-domain"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 3000",
    "dev:practice": "npm run dev --workspace @logic/practice",
    "dev:all": "concurrently --kill-others-on-fail --names knowledge,practice \"npm run dev\" \"npm run dev:practice\"",
    "build": "vinext build",
    "build:practice": "npm run build --workspace @logic/practice",
    "build:all": "npm run build && npm run build:practice",
    "start": "vinext start",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test tests/*.test.mjs",
    "test:practice": "npm run test --workspace @logic/practice",
    "test:all": "npm run build:all && npm run test:built && npm run test:practice",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern apps/practice/dist",
    "typecheck": "tsc --noEmit --incremental false && npm run typecheck --workspace @logic/practice"
  },
  "dependencies": {
    "katex": "^0.18.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^9.2.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
